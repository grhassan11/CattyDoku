<?xml version="1.0" encoding="utf-8"?>
<!-- Native ad CTA: 20dp-radius pill with a touch ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/native_ad_cta_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ad_button_color" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
