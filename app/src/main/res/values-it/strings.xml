    <string name="play_reminder_body_2">Prenditi qualche minuto di calma e risolvi un livello.</string>
    <string name="play_reminder_title_3">🐾 I gatti ti aspettano</string>
    <string name="play_reminder_body_3">Vieni a salutare e trova a tutti un posticino accogliente.</string>
    <string name="play_reminder_title_4">🐟 Pausa puzzle all\'ora dello spuntino</string>
    <string name="play_reminder_body_4">Regalati un livello veloce stasera.</string>
    <string name="play_reminder_title_5">🎮 Pronto per il prossimo livello?</string>
