    <string name="daily_reminder_body_7">Ancora un puzzle prima che i gatti si mettano a dormire.</string>
    <string name="sudoku_reminder_channel_name">Promemoria Sudoku</string>
    <string name="sudoku_reminder_channel_desc">Un miagolio amichevole quando c\'è un Sudoku da finire</string>
