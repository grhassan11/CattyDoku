# Normalise line endings: LF in the repo and in the working tree.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ogg binary
*.mp3 binary
*.wav binary
*.aif binary
*.aiff binary
*.ttf binary
*.otf binary
*.jar binary
*.aar binary
*.keystore binary
*.jks binary
